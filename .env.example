# =====================================================================
# La Petite Maison de l'Épouvante — local configuration template
# Copy to .env (git-ignored) and replace every "change-me" value:
#   cp .env.example .env
# The same .env feeds Docker Compose (part A) and `make secrets` (part B).
# =====================================================================

# --- PostgreSQL (superuser, local only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- catalog database ---
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=change-me

# --- keycloak database ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak bootstrap admin (master realm) ---
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Realm "petite-maison": test users and clients ---
KC_USER_NESRINE_PASSWORD=change-me
KC_USER_ADMIN_PASSWORD=change-me
KC_FRONTEND_CLIENT_SECRET=change-me

# --- Valkey ---
VALKEY_PASSWORD=change-me

# --- Frontend (Auth.js) — generate with: openssl rand -base64 32 ---
AUTH_SECRET=change-me

# --- Container registry (GHCR owner, lowercase) ---
GHCR_OWNER=l3miage-allouchn
